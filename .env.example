# ==============================================================================
# [1] 디스코드 웹후크 설정 (필수)
# 디스코드 채널 편집 -> 연동 -> 웹후크 -> 새 웹후크 -> '웹후크 URL 복사' 후 붙여넣기
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/여기에_웹후크_URL을_넣어주세요
DISCORD_BOT_TOKEN=여기에_디스코드_봇_토큰을_넣어주세요

# ==============================================================================
# [2] 방송인 및 치지직(Chzzk) 설정
# CHZZK_CHANNEL_ID를 비워두면 STREAMER_NAME으로 자동 검색을 시도합니다.
# (직접 넣으려면 https://chzzk.naver.com/ 뒤의 32자리 영문+숫자 코드를 입력하세요)
# ==============================================================================
STREAMER_NAME=탬탬버린
CHZZK_CHANNEL_ID=a7e175625fdea5a7d98428302b7aa57f

# ==============================================================================
